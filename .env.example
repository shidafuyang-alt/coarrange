# Copy to a file that is not committed, then export these variables
# in the same terminal that runs `npm start`. Do not put a real key here.

# Required only for the Hum page button that generates a full piece.
DEEPSEEK_API_KEY=

# ACE-Step checkout root: the folder that contains code/ and checkpoints/.
# Not code/ itself, and not checkpoints/ itself.
#   $ACESTEP_ROOT/code/cli.py
#   $ACESTEP_ROOT/code/.venv/bin/python
#   $ACESTEP_ROOT/checkpoints/acestep-v15-turbo/model.safetensors
ACESTEP_ROOT=

# Optional. Apple Silicon can leave these unset (mps + mlx).
# Other platforms must override both; mps and mlx are Apple-only.
# ACESTEP_PYTHON=
# ACESTEP_DEVICE=cuda
# ACESTEP_BACKEND=pt
