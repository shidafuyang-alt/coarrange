# Copy to .env. Only the backend reads this file. Never put keys in web/.
PORT=8788
MUSICCRAFT_MANAGED=true
MUSICCRAFT_DOMESTIC_ONLY=true

# STEP 1: Prompt generation and planning. Provide either project key, or both.
# Preferred provider for Auto select: deepseek or openai.
PROMPT_PROVIDER=deepseek
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# STEP 2: Chinese music API, independent of the creative assistant key.
# https://platform.mureka.ai/  (create a project API key in the console)
MUREKA_API_KEY=
# Legacy overseas providers are hidden while MUSICCRAFT_DOMESTIC_ONLY=true.
FAL_KEY=
# Optional dedicated ACE-Step 1.5 service.
ACESTEP_BASE_URL=
ACESTEP_API_KEY=
ACESTEP_MODEL=

# Singing conversion: dedicated team GPU worker.
VOICE_WORKER_BASE_URL=
VOICE_WORKER_API_KEY=

# Optional FFmpeg override; otherwise uses the bundled ffmpeg-static executable.
MUSICCRAFT_FFMPEG=
# Optional existing compatible text LLM; shown as a separate Project LLM choice.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_JSON_MODE=true
# Enable the previous fal text-LLM adapter only when explicitly needed.
PROMPT_FAL_FALLBACK=false
FAL_LLM_MODEL=google/gemini-2.5-flash
MUSIC_TIMEOUT_MS=900000
MUSIC_POLL_MS=2000
