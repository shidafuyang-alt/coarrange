{
  "name": "coarrange-audio-midi",
  "private": true,
  "type": "module",
  "description": "Browser-side hum transcription using @spotify/basic-pitch. Not a copy of htmlapps-audio-to-midi.",
  "scripts": {
    "test": "node test-recordings.mjs",
