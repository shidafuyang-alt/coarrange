{
  "name": "coarrange",
  "version": "0.1.0",
  "private": true,
  "description": "A bilingual music arrangement demo with prepared AI audio and an editable sampled-instrument workbench.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "check": "node scripts/check.mjs && node --test tests/*.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.6.2"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0"
  }
}
